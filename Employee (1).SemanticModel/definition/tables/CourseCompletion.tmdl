table CourseCompletion
	lineageTag: 2d02412b-178a-4407-b2d9-083b4c15fd74

	measure TotalCourses = ```
			COUNTROWS(CourseCompletion)
			
			```
		formatString: 0
		lineageTag: 5c6972f6-3904-48be-a6d6-17bbc541c22e

	measure CompletedCourses = ```
			CALCULATE(COUNTROWS(CourseCompletion), CourseCompletion[Status] = "Completed")
			
			```
		formatString: 0
		lineageTag: fa878d78-6dd0-4b43-8234-1b332fcb47f5

	measure CompletionRate = ```
			DIVIDE([CompletedCourses], [TotalCourses], 0)
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 361bd785-2c34-447d-917b-33482438cfe8

	measure PendingCourses = ```
			
			VAR cnt =
			    CALCULATE(
			        COUNTROWS(CourseCompletion),
			        CourseCompletion[Status] = "Not Completed"
			    )
			RETURN
			IF(ISBLANK(cnt), 0, cnt)
			
			
			```
		formatString: 0
		lineageTag: e8949eeb-66e3-47c7-abff-75e1915945d7

	measure OverdueCourses = ```
			
			VAR cnt =
			    CALCULATE(
			        COUNTROWS(CourseCompletion),
			        CourseCompletion[OverdueFlag] = 1
			    )
			RETURN
			IF(ISBLANK(cnt), 0, cnt)
			
			```
		formatString: 0
		lineageTag: 2a0fce91-f53a-409b-bddd-14745f1c723c

	measure PendingPerEmployee = ```
			
			CALCULATE(
			    COUNTROWS(CourseCompletion),
			    FILTER(CourseCompletion, CourseCompletion[Status] = "Not Completed")
			)
			
			```
		formatString: 0
		lineageTag: 0526ebd0-492c-43c4-9881-483a8adeffa9

	measure 'Count of CourseName' = count(CourseCompletion[CourseName])
		formatString: 0
		lineageTag: 880462e7-c178-4927-b2e7-dd700ffb7ae2

	measure UserprincipleNameF = USERPRINCIPALNAME()
		lineageTag: 413941d6-3876-46db-ae05-ef513fa97f76

