	column OverdueFlag = ```
			
			IF(
			    CourseCompletion[Status] = "Not Completed"
			    && CourseCompletion[DueDate] < DATE(2025,10,20),
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: 8bc02ced-632f-4ebf-aa5c-5ff34f9c6b3f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DueSoonFlag = ```
			
			IF(
			    CourseCompletion[Status] = "Not Completed"
			    && CourseCompletion[DueDate] >= DATE(2025,10,20)
			    && CourseCompletion[DueDate] <= DATE(2025,10,20) + 7,
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: e59b23e4-8532-4720-a574-4767a71218f2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaysRemaining = ```
			
			DATEDIFF(TODAY(), CourseCompletion[DueDate], DAY)
			
			
			
			
			```
		formatString: 0
		lineageTag: e6757e1a-0b2c-4ce8-9768-6148a5bed049
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

